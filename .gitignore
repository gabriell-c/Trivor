# Data, SQLite & Temporary Files
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
# Sidecars do modo WAL do SQLite (criados ao lado do *.db)
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm

# Logs & junk files (nomes específicos; *.log cobre os demais)
*.log
market_log.txt
backend_log.txt
backend_err.txt
stdout.log
stderr.log

# Trae AI & Debug Artifacts
.trae/
debug*.py
debug*.txt
debug*.md

# Sensitive material (NÃO versionado)
reference/

# apply (Job Hunter) — PII, credenciais e dados pessoais nunca vão pro git
# (.env e venv/ já estão cobertos pelos padrões acima)
apply/config.yaml
apply/*_session.json
apply/*_session.pkl
apply/relatorio/
apply/resumes/
apply/sessions/

# Node / Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.pnpm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# System & OS
.DS_Store
Thumbs.db
desktop.ini

