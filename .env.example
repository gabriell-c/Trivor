# ============================================================
# Trivor — Variáveis de Ambiente
# Copie para .env e preencha com seus valores
# ============================================================

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-your-openai-key-here
# Opcional: endpoint compatível com OpenAI (padrão: API oficial da OpenAI).
# Usada como fallback quando o provider em TRIVOR_IAS não define apiUrl.
OPENAI_BASE_URL=

# ---------- Trivor IA Providers ----------
# JSON array com providers configurados.
# Exemplo:
# TRIVOR_IAS=[{"id":"1","name":"OpenAI","provider":"openai","apiKey":"sk-...","apiUrl":"https://api.openai.com/v1","modelName":"gpt-4o","usedFor":"all"}]
TRIVOR_IAS=[]

# ---------- JSearch (RapidAPI) ----------
# Chaves JSearch são gerenciadas via painel na UI.
# Opcionalmente, defina uma chave padrão aqui:
# JSEARCH_API_KEY=  # chave extra p/ pool de vagas (opcional)

# ---------- CORS ----------
# Origens permitidas separadas por vírgula.
# Em produção, substitua pelo domínio real:
# CORS_ALLOW_ORIGINS=https://trivor.seudominio.com
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ---------- Logs ----------
# Caminho do arquivo de log do serviço de mercado.
# Padrão: backend/market_log.txt (relativo ao backend/).
# Em Docker/CI, aponte para um volume/montado se não quiser recriar o arquivo:
# TRIVOR_MARKET_LOG=/var/log/trivor/market.log
TRIVOR_MARKET_LOG=

# ---------- apply (Job Hunter) ----------
# Diretório do projeto "apply" (aba Candidaturas). Padrão: pasta irmã ../apply.
# Se definida, é autoritativa — sem fallback para o padrão.
# APPLY_DIR=
